# Telegram Bot Token (required)
BOT_TOKEN=

# Admin user IDs (comma-separated, required for admin panel)
ADMIN_IDS=

# OpenAI-compatible AI API (optional - AI features disabled if not set)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Database path (optional - defaults to storage/database.sqlite3)
DATABASE_PATH=storage/database.sqlite3

# File size limits (bytes)
MAX_FILE_SIZE=52428800
MAX_DOWNLOAD_SIZE=104857600

# Rate limiting
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60

# Temporary files cleanup (seconds)
TEMP_FILE_TTL=3600

# Default language (en or si)
DEFAULT_LANGUAGE=en

# Logging
LOG_LEVEL=INFO

# Web API Configuration
# API Key for admin dashboard authentication (required for web API)
WEB_API_KEY=your-secret-api-key-here

# Allow public access to stats endpoint (set to true for public stats)
WEB_ALLOW_PUBLIC_STATS=false